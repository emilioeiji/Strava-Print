DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Tokyo
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
EXPORT_JOBS_INLINE=1
EXPORT_WORKER_POLL_SECONDS=2
EXPORT_JOB_STALE_MINUTES=30
EXPORT_JOB_MAX_ATTEMPTS=3
STORE_CURRENCY=jpy
PRICE_DIGITAL=2900
PRICE_KIT=7900
PRICE_FRAMED=12900
SHIPPING_KIT=900
SHIPPING_FRAMED=1200
STORE_CONTACT_EMAIL=owner@example.com
DEFAULT_FROM_EMAIL=GPX Print Studio <noreply@example.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
MANUAL_PAYMENT_INSTRUCTIONS=Entraremos em contato por e-mail para combinar o pagamento e a entrega.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-northeast-1
# AWS_S3_ENDPOINT_URL=
# MariaDB local. Em desenvolvimento, deixe DB_NAME vazio para usar SQLite.
DB_NAME=
DB_USER=strava_print
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Alternativa: DATABASE_URL=mysql://strava_print:password@127.0.0.1:3306/strava_print
